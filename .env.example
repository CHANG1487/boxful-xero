# Xero Developer App credentials (developer.xero.com)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/auth/callback

# Xero OAuth scopes required by this app（Xero 新版顆粒化 scope，每個端點一個）
XERO_SCOPES=offline_access accounting.invoices.read accounting.manualjournals.read accounting.contacts.read accounting.settings.read

# Session cookie signing key (any long random string)
SESSION_SECRET=change-me-to-something-random

# Server port
PORT=3000

# 啟用日切點（YYYY-MM-DD）：早於此日期的憑證預設視為「已列印」，不會出現在未列印清單。
# 用途：跳過歷史舊憑證，只從平台導入日開始追蹤列印狀態。
PRINT_CUTOFF_DATE=2026-07-01
