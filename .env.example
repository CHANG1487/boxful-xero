# Xero Developer App credentials (developer.xero.com)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/auth/callback

# Xero OAuth scopes required by this app（Xero 新版顆粒化 scope，每個端點一個）
XERO_SCOPES=offline_access accounting.invoices.read accounting.manualjournals.read accounting.banktransactions.read accounting.contacts.read accounting.settings.read

# Session cookie signing key (any long random string)
SESSION_SECRET=change-me-to-something-random

# Server port
PORT=3000
